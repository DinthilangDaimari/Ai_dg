# Dinthi AI Backend Environment Variables (Template Only)
# Copy this file to server/.env for local testing, or configure these keys
# directly in your Node.js HTTPS hosting provider's environment settings.
# NEVER commit server/.env or real credentials to Git.

# Server port (cloud hosts such as Cloud Run, Render, Railway, Fly.io inject PORT automatically)
PORT=3000
NODE_ENV=production

# Google Gemini API key (SERVER-SIDE ONLY - never expose to Android or GitHub Pages)
GEMINI_API_KEY=

# Optional static backend client token (Android uses POST /api/auth/session ephemeral tokens by default)
APP_CLIENT_TOKEN=

# Public HTTPS base URL of THIS Node.js backend service (NOT the GitHub Pages frontend URL!)
# Example: https://dinthi-ai-backend.onrender.com
PUBLIC_WEBHOOK_URL=

# Comma-separated browser origins allowed by CORS (GitHub Pages origin included by default)
CORS_ALLOWED_ORIGINS=https://dinthilangdaimari.github.io

# Legitimate Telephony Provider Configuration (Twilio Programmable Voice)
# Leave blank until real Twilio credentials and a legitimate Twilio phone number are supplied.
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Automatically verified when NODE_ENV=production and PUBLIC_WEBHOOK_URL + TWILIO_AUTH_TOKEN are set.
# Set to true to always enforce in dev, or false only for local tunnel debugging.
TWILIO_VALIDATE_SIGNATURES=true
